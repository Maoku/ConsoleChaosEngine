{
  "name": "@console-chaos/engine-testkit",
  "version": "0.1.0",
  "description": "Deterministic browser-free test doubles for @console-chaos/engine.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "game-engine",
    "testing",
    "typescript"
  ],
  "scripts": {
    "build": "npm run build --workspace @console-chaos/engine && vite build --config vite.config.package.ts && tsc -p tsconfig.build.json --emitDeclarationOnly && node ../../tools/fix-declaration-specifiers.mjs dist",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@console-chaos/engine": "^0.1.0"
  }
}
