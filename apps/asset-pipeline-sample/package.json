{
  "name": "@console-chaos/asset-pipeline-sample",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "assets:build": "console-chaos-assets build --config tools/art.config.mjs",
    "assets:check": "console-chaos-assets check --config tools/art.config.mjs",
    "check:assets": "tsx tools/check-assets.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "verify": "npm run assets:check && npm run check:assets && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@console-chaos/engine": "0.2.0"
  },
  "devDependencies": {
    "@console-chaos/asset-pipeline": "0.1.0",
    "@console-chaos/engine-testkit": "0.2.0",
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
