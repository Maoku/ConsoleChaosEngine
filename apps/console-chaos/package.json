{
  "name": "@console-chaos/console-chaos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:budget": "tsx tools/check-line-budget.ts",
    "check:levels": "tsx tools/check-levels.ts",
    "check:trademark": "tsx tools/check-trademark.ts",
    "check:assets": "tsx tools/gltf-preflight.ts && tsx tools/check-textures.ts",
    "import:textures": "tsx tools/import-textures.ts",
    "make:textures": "tsx tools/make-textures.ts",
    "make:hero-sprite": "tsx tools/make-hero-sprite.ts",
    "bench:sort": "tsx tools/bench-sort.ts",
    "playtest": "vite build && vite preview --host --port 4173",
    "playtest:report": "tsx tools/playtest-report.ts",
    "verify": "npm run lint && npm run test && npm run check:budget && npm run check:levels && npm run check:trademark && npm run check:assets && npm run build"
  },
  "dependencies": {
    "@console-chaos/engine": "0.1.0",
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
